# ============================================
# ReachInbox Email Scheduler - Environment Setup
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# DATABASE (PostgreSQL)
# ============================================
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/email_scheduler?schema=public

# ============================================
# REDIS (Session Store & Queue)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_password_here    # Optional, if Redis requires authentication

# ============================================
# SMTP (Email Sending via Ethereal)
# ============================================
# For testing, use Ethereal: https://ethereal.email/
# For production, use SendGrid, AWS SES, or your mail provider

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-email@ethereal.email
SMTP_PASSWORD=your-ethereal-password-here
SMTP_FROM=your-ethereal-email@ethereal.email

# ============================================
# GOOGLE OAUTH 2.0
# ============================================
# Get credentials from: https://console.cloud.google.com
# 1. Create new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/google/callback
# 5. Copy Client ID and Secret below

GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ============================================
# FRONTEND URL (For OAuth Redirects)
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# SESSION SECRET (Min 32 chars, should be random)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-secret-key-minimum-32-characters-long

# ============================================
# SLACK INTEGRATION (Optional)
# ============================================
# Get credentials from: https://api.slack.com/apps
# 1. Create new app
# 2. Enable OAuth & Permissions
# 3. Add scope: chat:write
# 4. Set redirect URL: http://localhost:3000/api/integrations/slack/callback
# 5. Copy credentials below

# For testing without Slack, use dummy values:
SLACK_CLIENT_ID=xoxp-slack-client-id-here
SLACK_CLIENT_SECRET=xoxp-slack-client-secret-here
SLACK_CALLBACK_URL=http://localhost:3000/api/integrations/slack/callback

# Generate a random 64-char hex key for token encryption:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLACK_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# ELASTICSEARCH (Optional, for email search)
# ============================================
# Leave empty to disable search feature
# For testing: Use Elastic Cloud free tier from https://cloud.elastic.co/

ELASTICSEARCH_URL=https://your-elasticsearch-instance.us-central1.gcp.elastic-cloud.com:9243
ELASTICSEARCH_API_KEY=your-elastic-api-key-here

# ============================================
# PERFORMANCE TUNING
# ============================================

# Maximum concurrent email sends per worker
WORKER_CONCURRENCY=5

# Minimum milliseconds between emails from same sender
MIN_EMAIL_DELAY_MS=2000

# Maximum emails per sender per hour
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ============================================
# PRODUCTION NOTES
# ============================================
# When deploying to production:
# 1. Set NODE_ENV=production
# 2. Update all URLs to production domain
# 3. Use strong SESSION_SECRET (generate with crypto module)
# 4. Use production SMTP service (not Ethereal)
# 5. Use production database with proper backups
# 6. Use managed Redis (AWS ElastiCache, Heroku Redis, etc.)
# 7. Enable Elasticsearch for search functionality
# 8. Set secure: true in session cookie configuration (already in code)
# 9. Update GOOGLE_CALLBACK_URL to production domain
# 10. Update SLACK_CALLBACK_URL to production domain
# 11. Never commit .env file to version control
