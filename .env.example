# ========================================
# DEVELOPMENT ENVIRONMENT TEMPLATE
# Copy this to .env and fill in your local values
# 
# IMPORTANT: .env is in .gitignore - never commit it
# ========================================

# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=3000

# ========================================
# DATABASE: PostgreSQL (Local Development)
# ========================================
# For local development, use:
# 1. Install PostgreSQL locally
# 2. Create database: createdb email_scheduler
# 3. Run migrations: npx prisma migrate dev
#
# Connection format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public

# ========================================
# REDIS: Cache & Job Queue (Local Development)
# ========================================
# For local development:
# 1. Install Redis locally
# 2. Run: redis-server
#
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# FRONTEND: Development URL
# ========================================
# Local frontend dev server
FRONTEND_URL=http://localhost:5173

# ========================================
# GOOGLE OAUTH: Development App
# ========================================
# Create at: https://console.cloud.google.com
# Steps:
# 1. Create new project
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: http://localhost:3000/api/auth/google/callback
# 4. Copy Client ID and Secret
#
# For testing, you can use mock values:
GOOGLE_CLIENT_ID=dev-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dev-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ========================================
# SESSION: Express Session Secret
# ========================================
# For development, this can be any string
# For production, use a strong random value:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-session-secret-key-for-local-testing

# ========================================
# SLACK INTEGRATION: Development (Optional)
# ========================================
# For local development, use mock values
# In production, create real Slack app at: https://api.slack.com/apps
#
SLACK_CLIENT_ID=mock_slack_id
SLACK_CLIENT_SECRET=mock_slack_secret
SLACK_CALLBACK_URL=http://localhost:3000/api/integrations/slack/callback

# For production, generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SLACK_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ========================================
# SMTP EMAIL SERVICE: Development
# ========================================
# For local development, use Ethereal (test SMTP service)
# 1. Go to: https://ethereal.email
# 2. Click "Create Ethereal Account"
# 3. You get test SMTP credentials instantly
# 4. Copy them below
# 5. Emails are "sent" but actually go to Ethereal dashboard
# 6. View "sent" emails: https://ethereal.email/messages
#
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-email@ethereal.email
SMTP_PASSWORD=your-ethereal-password
SMTP_FROM=your-ethereal-email@ethereal.email

# ========================================
# EMAIL PERFORMANCE TUNING
# ========================================
# These are safe defaults for development
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=0
MAX_EMAILS_PER_HOUR_PER_SENDER=1000

# ========================================
# ELASTICSEARCH: Email Search (Optional)
# ========================================
# For development, this is optional
# Leave blank to disable search features
# In production, use Elastic Cloud: https://cloud.elastic.co
#
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# ========================================
# NOTES FOR DEVELOPERS
# ========================================
# 1. NEVER commit this .env file to git (.gitignore prevents it)
# 2. Generate your own values from services:
#    - Google: https://console.cloud.google.com
#    - Ethereal: https://ethereal.email
#    - Slack: https://api.slack.com/apps
# 3. For production deployment to Render, see:
#    - BACKEND_PRODUCTION_ENV_GUIDE.md
#    - RENDER_DEPLOYMENT_MATRIX.md
# 4. If you see "Invalid environment variables" error:
#    - Check all required variables are set (no blanks)
#    - Check DATABASE_URL and REDIS_HOST aren't trying to connect to wrong host
#    - Check GOOGLE_CLIENT_ID isn't empty
# 5. Questions? See src/config/env.ts for validation schema

# ========================================
# QUICK START
# ========================================
# After filling in this .env file:
# 1. npm install
# 2. npx prisma migrate dev (creates/updates database)
# 3. npm run dev (starts backend)
# In another terminal:
# 4. cd frontend && npm run dev (starts frontend)
# 5. Open http://localhost:5173/login
# 6. Click "Continue with Google" to test OAuth
