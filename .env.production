# ========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# For Render Deployment
# ========================================
# 
# IMPORTANT: This file shows WHAT EACH VARIABLE SHOULD BE.
# DO NOT commit actual secrets to this file or git.
# Use Render Dashboard to set these values instead.
#
# Guide: See BACKEND_PRODUCTION_ENV_GUIDE.md for step-by-step setup
# ========================================

# ========================================
# CORE SERVER CONFIGURATION
# ========================================
NODE_ENV=production
PORT=3000

# ========================================
# DATABASE: PostgreSQL via Render Add-on
# ========================================
# Get from Render Dashboard → Your Service → Add-ons → PostgreSQL
# It will auto-populate as: postgresql://user:password@host:5432/dbname?schema=public
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://user:password@hostname.render.internal:5432/email_scheduler?schema=public

# ========================================
# REDIS: Cache & Job Queue via Render Add-on
# ========================================
# Get from Render Dashboard → Your Service → Add-ons → Redis
# If Render gives REDIS_URL, parse it into these components:
# Format: redis://[password]@[host]:[port]
# Parse from: redis://:password@hostname:6379
REDIS_HOST=hostname.render.internal
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ========================================
# FRONTEND: Vercel Production URL
# ========================================
# This must match your Vercel frontend domain EXACTLY
# Used for:
# - CORS origin validation
# - OAuth redirects after Google login
# - Error redirects
# Format: https://your-frontend-domain.vercel.app (NO TRAILING SLASH)
FRONTEND_URL=https://emailscheduler-3ja3rfexv-professional7.vercel.app

# ========================================
# GOOGLE OAUTH: Production App
# ========================================
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# IMPORTANT: Create NEW app for production (don't use dev credentials)
# 
# Steps:
# 1. Go to Google Cloud Console
# 2. Create OAuth 2.0 Client ID (Web application type)
# 3. Add redirect URI: https://outbox-email-scheduler-wl9y.onrender.com/api/auth/google/callback
# 4. Copy Client ID and Secret below
#
# SECURITY: These are sensitive - never share or commit to git
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_CALLBACK_URL=https://outbox-email-scheduler-wl9y.onrender.com/api/auth/google/callback

# ========================================
# SESSION: Express Session Secret
# ========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# SECURITY: Must be a strong random value. Never reuse or share.
# This encrypts user session cookies. If compromised, users can be impersonated.
SESSION_SECRET=a1b2c3d4e5f6789012345678901234567890123456789012345678901234

# ========================================
# SLACK INTEGRATION: Notifications (Optional)
# ========================================
# Create at: https://api.slack.com/apps → Create New App
# 
# Steps:
# 1. Go to Slack API console
# 2. Create new app from scratch
# 3. Add OAuth Permissions scope: chat:write
# 4. Add redirect URI: https://outbox-email-scheduler-wl9y.onrender.com/api/integrations/slack/callback
# 5. Get Client ID and Secret from "Basic Information"
#
# If you're not using Slack, use mock values:
# SLACK_CLIENT_ID=mock_slack_id
# SLACK_CLIENT_SECRET=mock_slack_secret
SLACK_CLIENT_ID=your-production-slack-client-id
SLACK_CLIENT_SECRET=your-production-slack-client-secret
SLACK_CALLBACK_URL=https://outbox-email-scheduler-wl9y.onrender.com/api/integrations/slack/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECURITY: 64-character hex string for AES-256-GCM encryption of Slack tokens
SLACK_TOKEN_ENCRYPTION_KEY=b1c2d3e4f5a6789012345678901234567890123456789012345678901234

# ========================================
# SMTP EMAIL SERVICE: Production Provider
# ========================================
# Choose ONE provider and set credentials below
#
# OPTIONS:
# 1. SendGrid (Recommended - Free tier available)
#    - Sign up: https://sendgrid.com
#    - Free: 100 emails/day
#    - SMTP_HOST=smtp.sendgrid.net
#    - SMTP_PORT=587
#    - SMTP_USER=apikey
#    - SMTP_PASSWORD=<your SendGrid API key>
#
# 2. AWS SES (If using AWS)
#    - SMTP_HOST=email-smtp.us-east-1.amazonaws.com (use your region)
#    - SMTP_PORT=587
#    - SMTP_USER=<SMTP username from AWS>
#    - SMTP_PASSWORD=<SMTP password from AWS>
#
# 3. Mailgun (Free tier with limits)
#    - SMTP_HOST=smtp.mailgun.org
#    - SMTP_PORT=587
#    - SMTP_USER=<Mailgun SMTP username>
#    - SMTP_PASSWORD=<Mailgun SMTP password>
#
# 4. Brevo (formerly Sendinblue)
#    - SMTP_HOST=smtp-relay.brevo.com
#    - SMTP_PORT=587
#    - SMTP_USER=<your Brevo account>
#    - SMTP_PASSWORD=<your Brevo SMTP key>
#
# SMTP_FROM must match a verified sender in your mail provider

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key-here
SMTP_FROM=noreply@yourdomain.com

# ========================================
# EMAIL PERFORMANCE TUNING
# ========================================
# WORKER_CONCURRENCY: Number of emails to send simultaneously
#   - Default: 5
#   - Increase for faster delivery (5-10)
#   - Decrease if SMTP provider throttles (2-3)
#   - Check your mail provider's rate limits
WORKER_CONCURRENCY=5

# MIN_EMAIL_DELAY_MS: Minimum milliseconds between emails per sender
#   - Default: 0 (send as fast as possible)
#   - Set to 1000-2000 for throttling if needed
#   - Prevents SMTP provider rate limiting
MIN_EMAIL_DELAY_MS=0

# MAX_EMAILS_PER_HOUR_PER_SENDER: Hourly rate limit per sender
#   - Default: 1000 (1000 emails/hour per sender)
#   - Adjust based on your SMTP provider's hourly limit
#   - SendGrid: up to 300 emails/sec (~1M/hour)
#   - AWS SES: varies by region, usually 14 emails/sec (~50k/hour initially)
#   - Mailgun: 600 emails/min (~36k/hour)
MAX_EMAILS_PER_HOUR_PER_SENDER=1000

# ========================================
# ELASTICSEARCH: Email Search & Analytics (Optional)
# ========================================
# If you want to search/analyze sent emails, set these values.
# If omitted, email search features are disabled (graceful degradation).
#
# Options:
# 1. Elastic Cloud (Managed): https://cloud.elastic.co
#    - Free tier available
#    - Get URL and API key from console
#
# 2. Self-hosted Elasticsearch
#    - Set ELASTICSEARCH_URL to your instance
#    - Set API key for authentication
#
# Leave blank to disable search features:
# ELASTICSEARCH_URL=
# ELASTICSEARCH_API_KEY=

ELASTICSEARCH_URL=https://your-elasticsearch-instance.es.us-central1.gcp.elastic-cloud.com:9243
ELASTICSEARCH_API_KEY=your-elasticsearch-api-key-here

# ========================================
# SUMMARY: Which Variables Auto-Set on Render
# ========================================
# These are AUTOMATICALLY set by Render (don't set manually):
# - PORT: Render sets to dynamic port (we use 3000 but Render may override)
# - DATABASE_URL: Auto-created when you add PostgreSQL add-on
# - REDIS_HOST, REDIS_PORT, REDIS_PASSWORD: From Redis add-on
#
# These MUST be set manually on Render Dashboard → Environment:
# - NODE_ENV, FRONTEND_URL, GOOGLE_CLIENT_ID/SECRET, SESSION_SECRET, etc.
# - All email service credentials
# - All OAuth secrets
# - All encryption keys

# ========================================
# DEPLOYMENT INSTRUCTIONS
# ========================================
# 1. Generate strong secrets (see BACKEND_PRODUCTION_ENV_GUIDE.md)
# 2. Set up Render PostgreSQL and Redis add-ons
# 3. Create production OAuth apps (Google, Slack)
# 4. Get SMTP credentials from email provider
# 5. Go to Render Dashboard → Your Service → Environment
# 6. Add each variable from this file (with actual values, not templates)
# 7. Click "Save Changes" - Render will redeploy automatically
# 8. Check logs: Render Dashboard → Logs tab
# 9. Verify: curl https://outbox-email-scheduler-wl9y.onrender.com/health
# 10. Test OAuth: Click login on frontend → "Continue with Google"

# ========================================
# VERIFICATION AFTER DEPLOYMENT
# ========================================
# Health Check:
#   curl https://outbox-email-scheduler-wl9y.onrender.com/health
#   Expected: {"status":"ok","environment":"production"}
#
# Google OAuth:
#   Go to frontend login, click "Continue with Google"
#   Should redirect to Google (not error page)
#
# Database:
#   Login successfully (tests DB connection)
#
# Redis & Jobs:
#   Go to https://outbox-email-scheduler-wl9y.onrender.com/admin/queues
#   Should see Bull Board dashboard
#
# Email Sending:
#   Compose and send test email
#   Check Render logs for "Email sent successfully"

# ========================================
# TROUBLESHOOTING
# ========================================
# If something fails, check:
# 1. Render service logs (Dashboard → Logs)
# 2. Environment variable values (Dashboard → Environment)
# 3. Render add-ons are added (Dashboard → Add-ons)
# 4. All OAuth callback URLs match exactly (Google/Slack console)
# 5. SMTP credentials are correct (test with provider's tools first)
# 6. DATABASE_URL and REDIS_* aren't pointing to localhost
#
# See BACKEND_PRODUCTION_ENV_GUIDE.md Part 4 for common errors & fixes

# ========================================
# LAST UPDATED: August 29, 2026
# STATUS: Ready for Render Deployment
# ========================================
